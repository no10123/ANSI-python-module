#debug theme
#by robopugo

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#ffffff", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

theme[main_bg]="#000000"
theme[main_fg]="#FFFFFF"

theme[title]="#FF0000"
theme[hi_fg]="#00FF00"

theme[selected_bg]="#0000FF"
theme[selected_fg]="#FFFF00"

theme[inactive_fg]="#FF00FF"

theme[proc_misc]="#00FFFF"

theme[cpu_box]="#FF8800"
theme[mem_box]="#8800FF"
theme[net_box]="#00FF88"
theme[proc_box]="#FF0088"

theme[div_line]="#888888"

# Temperature
theme[temp_start]="#8B0000"
theme[temp_mid]="#FF4500"
theme[temp_end]="#FFD700"

# CPU
theme[cpu_start]="#00008B"
theme[cpu_mid]="#00BFFF"
theme[cpu_end]="#87CEFA"

# Free
theme[free_start]="#006400"
theme[free_mid]="#32CD32"
theme[free_end]="#ADFF2F"

# Cached
theme[cached_start]="#4B0082"
theme[cached_mid]="#9400D3"
theme[cached_end]="#DA70D6"

# Available
theme[available_start]="#8B4513"
theme[available_mid]="#CD853F"
theme[available_end]="#F4A460"

# Used
theme[used_start]="#8B0000"
theme[used_mid]="#DC143C"
theme[used_end]="#FF69B4"

# Download
theme[download_start]="#008080"
theme[download_mid]="#20B2AA"
theme[download_end]="#7FFFD4"

# Upload
theme[upload_start]="#808000"
theme[upload_mid]="#FFD700"
theme[upload_end]="#FFFFE0"